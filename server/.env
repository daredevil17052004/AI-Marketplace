DATABASE_URL=postgres://marketplace:ansh@localhost:5432/marketplace_dev

# Redis connection - matches docker-compose.yml
REDIS_URL=redis://localhost:6379

# Used to sign JWT access tokens. In real production this would be a
# long random string, e.g. generated with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_change_this_to_a_random_string_later
JWT_REFRESH_SECRET=dev_change_this_to_a_different_random_string

PORT=4000
NODE_ENV=development
